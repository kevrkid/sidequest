# /etc/sidequest/env  (owner root, chmod 600). Secrets live here and nowhere else.
# systemd reads this file: keep comments on their own lines, never after a value.
SQ_BETA=1
SQ_BEHIND_PROXY=1
SQ_BIND=127.0.0.1
PORT=8787
# Comma-separated invite codes. Delete this line for open sign-up.
SQ_INVITES=austin-beta
# Make one with: openssl rand -hex 24
SQ_ADMIN_TOKEN=
# Bill Claude to an API key (needed for serving the public), not a personal subscription.
# With these two set, the app calls the Anthropic API directly (no Claude Code CLI needed for the app).
SQ_USE_API_KEY=1
ANTHROPIC_API_KEY=
# Live video relay (LiveKit). Leave these empty and Live falls back to phone-to-phone video
# (a few viewers, Wi-Fi only). Pick one of the two:
# 1) LiveKit Cloud: SQ_LIVEKIT_URL=wss://<project>.livekit.cloud, key and secret from
#    cloud.livekit.io → Settings → Keys. Keep SQ_LIVEKIT_SELFHOST=0.
# 2) On this box: SQ_LIVEKIT_SELFHOST=1 (install.sh installs LiveKit with its TURN relay),
#    SQ_LIVEKIT_URL=wss://sidequest.cc.middlematter.com/livekit, SQ_LIVEKIT_API_URL=http://127.0.0.1:7880,
#    and make your own pair: key from openssl rand -hex 8, secret from openssl rand -hex 32.
SQ_LIVEKIT_URL=
SQ_LIVEKIT_KEY=
SQ_LIVEKIT_SECRET=
SQ_LIVEKIT_SELFHOST=0
SQ_LIVEKIT_API_URL=
# The site's name: self-hosted LiveKit's TURN relay uses Caddy's certificate for it.
SQ_DOMAIN=sidequest.cc.middlematter.com
# Google Places: ratings, price level and hours when someone taps a place. Leave empty for OpenStreetMap only.
# Restrict the key to the Places API (New) and this server's IP in Google Cloud.
SQ_GOOGLE_PLACES_KEY=
# Most paid detail lookups per day (the rest of the day shows OpenStreetMap only).
SQ_GOOGLE_DAILY=300
# Google map tiles (Map Tiles API): a browser key restricted to this site's address and tile.googleapis.com.
# deploy/google-places-setup.sh makes it. Leave empty for OpenStreetMap tiles.
SQ_GOOGLE_MAPS_BROWSER_KEY=
# Sign in with Google: the Web OAuth client id (…apps.googleusercontent.com) with this site's address as an
# authorized JavaScript origin. Leave empty to hide the Continue with Google button.
SQ_GOOGLE_CLIENT_ID=
# Scout's voice: a server key for Google Text-to-Speech (google-places-setup.sh makes it); empty = the phone's voice.
SQ_GOOGLE_TTS_KEY=
# Most characters of speech per day for everyone (about 1M a month is Google's free allowance).
SQ_TTS_DAILY_CHARS=30000
# Google nightclub searches per day for the map's Nightlife layer.
SQ_GOOGLE_NIGHT_DAILY=100
# Only used if SQ_ENGINE=cli forces the old way of running Claude.
CLAUDE_BIN=/usr/local/bin/claude
# The events scraper uses the same key.
CENTEX_CLAUDE_USE_SUBSCRIPTION=0
CENTEX_CLAUDE_BIN=/usr/local/bin/claude

# V2: contact address sent to push services with each phone notification (VAPID "sub"). The signing key itself is
# made on first start in app/data/vapid.json (keep it with the data backups; losing it means phones re-subscribe).
SQ_PUSH_CONTACT=mailto:kevrkid@gmail.com
