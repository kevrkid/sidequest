[Unit]
Description=Side Quest events scraper + API (Central Texas)
After=network-online.target
Wants=network-online.target

[Service]
User=sidequest
WorkingDirectory=/opt/sidequest/events
EnvironmentFile=/etc/sidequest/env
ExecStart=/opt/sidequest/events/.venv/bin/python -m centex_events serve --host 127.0.0.1 --port 8788
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/sidequest/events/data /tmp

[Install]
WantedBy=multi-user.target
